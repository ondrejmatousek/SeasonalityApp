@{
    var analysisLinks = new[]
    {
        (Url: "/", Label: "Seasonality & COT", Icon: "M3 3v14h14 M6 13l4-5 3 3 4-6", Current: ViewData["DataPage"] is not true && ViewData["LabPage"] is not true && ViewData["FmPage"] is not true && ViewData["PaperPage"] is not true && ViewData["BacktestPage"] is not true),
        (Url: "/strategy-lab/", Label: "Laboratoř strategií", Icon: "M7 3h6 M8 3v6l-4 7a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l-4-7V3 M6 13h8", Current: ViewData["LabPage"] is true),
        (Url: "/daily-outlook/", Label: "Denní výhled · FM", Icon: "M3 5h14v10H3z M3 9h14 M7 12h3", Current: ViewData["FmPage"] is true),
        (Url: "/paper-trading/", Label: "H4 Papertrading · 2R", Icon: "M4 3h12v14H4z M7 7h6 M7 10h6 M7 13h3", Current: ViewData["PaperPage"] is true),
        (Url: "/backtesting/", Label: "Backtesting", Icon: "M4 8a6 6 0 1 1 .5 6 M4 4v4h4 M10 7v4l2 1", Current: ViewData["BacktestPage"] is true)
    };
    var runsCurrent = ViewData["DataPage"] is true;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seasonality &amp; COT</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/market-help.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zone-chart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/trade-zones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/data-runs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/strategy-lab.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/strategy-trade-chart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fm-outlook.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/h4-paper.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/h4-paper-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/h4-paper-research.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/h4-backtest.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="journal-shell app-section-shell">
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" href="/">
                    <img class="brand-chart-mark" src="~/favicon.svg" asp-append-version="true" width="30" height="30" alt="" />
                    <span>Seasonality App</span>
                </a>
            </div>
        </nav>
    </header>
    <div class="app-workspace">
        <nav class="app-sidebar" aria-label="Sekce aplikace">
            <div class="sidebar-title">Analýza trhů</div>
            @foreach (var link in analysisLinks)
            {
                <a class="sidebar-link @(link.Current ? "active" : "")" href="@link.Url" aria-current="@(link.Current ? "page" : null)">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="@link.Icon" /></svg>
                    <span>@link.Label</span>
                </a>
            }
            <div class="sidebar-title">Data</div>
            <a class="sidebar-link @(runsCurrent ? "active" : "")" href="/runs/" aria-current="@(runsCurrent ? "page" : null)">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h10v14H5z M8 7h4 M8 10h4 M8 13h4" /></svg>
                <span>Denní běhy</span>
            </a>
        </nav>
        <main role="main" class="app-workspace-main">@RenderBody()</main>
    </div>
    <script src="~/js/static-market-data.js" asp-append-version="true"></script>
    <script src="~/js/data-runs.js" asp-append-version="true"></script>
    <script src="~/js/market-chart-ui.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-geometry.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-year-trends.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-reliability.js" asp-append-version="true"></script>
    <script src="~/js/cot-availability.js" asp-append-version="true"></script>
    <script src="~/js/core-market-registry.js" asp-append-version="true"></script>
    <script src="~/js/fx-relative-cot.js" asp-append-version="true"></script>
    <script src="~/js/core-cot.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-confluence.js" asp-append-version="true"></script>
    <script src="~/js/confluence-ui.js" asp-append-version="true"></script>
    <script src="~/js/asset-categories.js" asp-append-version="true"></script>
    <script src="~/js/screener-market-filter.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-ranking.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-confidence.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-scoring-v2.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-scoring-v3.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-exposures.js" asp-append-version="true"></script>
    <script src="~/js/opportunity-sorting.js" asp-append-version="true"></script>
    <script src="~/js/tradingview-links.js" asp-append-version="true"></script>
    <script src="~/js/opportunities-ui.js" asp-append-version="true"></script>
    <script src="~/js/cot-analogs.js" asp-append-version="true"></script>
    <script src="~/js/cot.js" asp-append-version="true"></script>
    <script src="~/js/market-candles.js" asp-append-version="true"></script>
    <script src="~/js/trade-zones.js" asp-append-version="true"></script>
    <script src="~/js/strategy-lab.js" asp-append-version="true"></script>
    <script src="~/js/strategy-lab-ui.js" asp-append-version="true"></script>
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js" asp-append-version="true"></script>
    <script src="~/js/market-chart-time.js" asp-append-version="true"></script>
    <script src="~/js/strategy-trade-chart.js" asp-append-version="true"></script>
    <script src="~/js/chart-drawing-tools.js" asp-append-version="true"></script>
    <script src="~/js/zone-price-chart.js" asp-append-version="true"></script>
    <script src="~/js/fm-order-blocks.js" asp-append-version="true"></script>
    <script src="~/js/fm-trade-zones.js" asp-append-version="true"></script>
    <script src="~/js/h4-paper.js" asp-append-version="true"></script>
    <script src="~/js/h4-paper-table.js" asp-append-version="true"></script>
    <script src="~/js/h4-paper-ui.js" asp-append-version="true"></script>
    <script src="~/js/h4-paper-research-ui.js" asp-append-version="true"></script>
    <script src="~/js/h4-history-format.js" asp-append-version="true"></script>
    <script src="~/js/h4-backtest-ui.js" asp-append-version="true"></script>
    <script src="~/js/fm-outlook-source.js" asp-append-version="true"></script>
    <script src="~/js/fm-outlook-ui.js" asp-append-version="true"></script>
    <script src="~/js/cfd-instruments.js" asp-append-version="true"></script>
    <script src="~/js/trade-zone-table.js" asp-append-version="true"></script>
    <script src="~/js/trade-zone-view-state.js" asp-append-version="true"></script>
    <script src="~/js/trade-zones-ui.js" asp-append-version="true"></script>
    <script src="~/js/seasonality.js" asp-append-version="true"></script>
    <script src="~/js/market-export.js" asp-append-version="true"></script>
    <script src="~/js/screener.js" asp-append-version="true"></script>
    <script src="~/js/market-help.js" asp-append-version="true"></script>
</body>
</html>
