@model TradingJournal.ViewModels.SeasonalityViewModel
<!doctype html><html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Sezonalita</title><link rel="stylesheet" href="~/css/site.css" /></head><body><main class="container"><h1>Sezonalita</h1><p>Historická sezónnost cen. Data se aktualizují automaticky jednou denně.</p><label for="asset">Akcie / aktivum</label><select id="asset">@foreach (var a in Model.Assets) { <option value="@a.Key">@a.Name (@a.Key)</option> }</select><div id="status" aria-live="polite">@(Model.IsUpdating ? "Aktualizace probíhá…" : "Připraveno")</div><canvas id="seasonality-chart" height="300"></canvas><pre id="seasonality-data" hidden>@System.Text.Json.JsonSerializer.Serialize(Model.Prices)</pre></main><script src="~/js/seasonality-geometry.js"></script><script src="~/js/seasonality.js"></script></body></html>
