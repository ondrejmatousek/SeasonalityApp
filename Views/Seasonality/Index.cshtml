@model TradingJournal.ViewModels.SeasonalityViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Seasonality & COT";
    ViewData["BodyClass"] = "journal-shell";
    var assets = Model.Assets.Select(asset => new { key = asset.Key, name = asset.Name, aliases = TradingJournal.Services.SeasonalityService.SearchAliases(asset.Key), assetClass = TradingJournal.Services.AssetClassification.ClassFor(asset), commodityGroup = TradingJournal.Services.AssetClassification.CommodityGroupFor(asset.Key) });
    var data = Model.Prices.ToDictionary(pair => pair.Key, pair => pair.Value.Select(item => new { date = item.Date.ToString("yyyy-MM-dd"), close = item.Close }));
}
<div class="seasonality-page" data-updating="@Model.IsUpdating.ToString().ToLowerInvariant()" data-data-url="@(Model.StaticManifestJson is null ? Url.Action("Data", "Seasonality") : "")" data-cot-url="@(Model.StaticManifestJson is null ? Url.Action("CotData", "Seasonality") : "")" data-capture-url="@Url.Content("~/lib/html2canvas/html2canvas.min.js")">
    <div class="seasonality-wrap">
        <header class="seasonality-header">
            <h1 id="market-instrument-title">@Model.Assets.FirstOrDefault()?.Name</h1>
            <nav class="market-view-tabs" role="tablist" aria-label="Analýza instrumentu">
                <button id="market-tab-seasonality" type="button" role="tab" aria-selected="true" aria-controls="market-seasonality-view" tabindex="0" class="is-active" data-market-tab="seasonality">Seasonality</button>
                <button id="market-tab-cot" type="button" role="tab" aria-selected="false" aria-controls="market-cot-view" tabindex="-1" data-market-tab="cot">COT</button>
                <button id="market-tab-screener" type="button" role="tab" aria-selected="false" aria-controls="market-screener-view" tabindex="-1" data-market-tab="screener">Screener</button>
            </nav>
            <div class="seasonality-asset-search" data-export-omit>
                <input id="seasonality-asset-search" type="search" value="@Model.Assets.FirstOrDefault()?.Name" autocomplete="off" spellcheck="false" aria-label="Vyhledat asset" aria-controls="seasonality-asset-suggestions" aria-expanded="false">
                <span id="seasonality-asset-loading" class="seasonality-asset-loading" aria-hidden="true"></span>
                <div id="seasonality-asset-suggestions" class="seasonality-asset-suggestions" role="listbox" hidden></div>
                <span id="seasonality-asset-status" class="seasonality-asset-status" role="status"></span>
            </div>
        </header>
        <section id="market-seasonality-view" class="market-seasonality-view" role="tabpanel" aria-labelledby="market-tab-seasonality">
        <nav class="seasonality-tabs" aria-label="Seasonality views">
            <button type="button" class="is-active" data-seasonality-tab="curve">Sezónní křivka</button>
            <button type="button" data-seasonality-tab="monthly">Měsíční přehled</button>
            <label class="seasonality-toolbar-history">Historie <select id="seasonality-years"><option value="5">Posledních 5 dokončených let</option><option value="10">Posledních 10 dokončených let</option><option value="20" selected>Posledních 20 dokončených let</option><option value="all">Všechna dostupná data</option></select></label>
            <button type="button" id="seasonality-export" class="market-export-button" data-export-view="seasonality" title="Stáhnout Seasonality jako PNG" aria-label="Stáhnout Seasonality jako PNG" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg></button>
        </nav>
        <section id="seasonality-monthly-view" class="seasonality-monthly-view" hidden>
            <div class="seasonality-monthly-toolbar">
                <label>Lookback <select id="seasonality-monthly-years" aria-label="Měsíční lookback"><option value="5">5 let</option><option value="10">10 let</option><option value="20" selected>20 let</option><option value="30">30 let</option><option value="all">Všechna dostupná data</option></select></label>
                <span id="seasonality-monthly-subtitle"></span>
            </div>
            <div class="seasonality-monthly-summary" id="seasonality-monthly-summary"></div>
            <div class="seasonality-monthly-panel"><div class="seasonality-detail-title">Průměrný měsíční výnos a win rate</div><canvas id="seasonality-monthly-canvas"></canvas><div class="seasonality-monthly-legend"><span><i class="is-positive"></i> Průměrný výnos</span><span><i class="is-win"></i> Podíl kladných měsíců</span></div></div>
            <div class="seasonality-monthly-table-wrap"><table class="seasonality-monthly-table"><thead><tr><th>Měsíc</th><th>Průměr</th><th>Win rate</th><th>Nejlepší rok</th><th>Nejhorší rok</th><th>Počet let</th></tr></thead><tbody id="seasonality-monthly-table"></tbody></table></div>
        </section>
        <div id="seasonality-curve-view">
        <section class="seasonality-filters">
            <details class="seasonality-filter-details" open>
            <summary>Roky a pokročilé filtry</summary>
            <div class="seasonality-filter-options">
            <div class="seasonality-filter-row"><button type="button" id="seasonality-all">Vše</button><button type="button" id="seasonality-none">Nic</button></div>
            <div class="seasonality-filter-group"><span>Market trend</span><button type="button" data-trend="bullish">Bullish</button><button type="button" data-trend="bearish">Bearish</button></div>
            <div class="seasonality-filter-group"><span>2-year cycle</span><button type="button" data-cycle="even">Sudé roky</button><button type="button" data-cycle="odd">Liché roky</button></div>
            <div class="seasonality-filter-group"><span>US election cycle</span><button type="button" data-election="election">Election</button><button type="button" data-election="pre">Pre-election</button><button type="button" data-election="post">Post-election</button><button type="button" data-election="midterm">Midterm</button></div>
            <div id="seasonality-year-list" class="seasonality-years-list"></div>
            </div>
            </details>
        </section>
        <section class="seasonality-analysis-layout">
            <div class="seasonality-analysis-main">
            <section class="seasonality-chart-panel"><div class="seasonality-chart-head"><div><strong id="seasonality-title"></strong><span id="seasonality-subtitle"></span></div><div class="seasonality-chart-actions"><button type="button" class="seasonality-chart-help" aria-label="Vysvětlení grafu">?<span class="seasonality-chart-help-popover" role="tooltip"><strong>Jak číst graf?</strong><br>Tyrkysová čára ukazuje průměrné sezonní chování vybraných roků. Výběrem úseku grafu zobrazíš výnos za dané období.</span></button><button type="button" id="seasonality-reset">Reset filtrů</button></div></div><div id="seasonality-sync-status" class="seasonality-sync-status"></div><div class="seasonality-chart-wrap"><canvas id="seasonality-canvas"></canvas><div id="seasonality-hover-guide" class="seasonality-hover-guide" data-export-omit aria-hidden="true" hidden></div><div id="seasonality-hover-marker" class="seasonality-hover-marker" data-export-omit aria-hidden="true" hidden></div><div id="seasonality-drag-preview" class="seasonality-drag-preview" hidden></div><div id="seasonality-tooltip" class="seasonality-tooltip" role="status"></div></div><div class="seasonality-axis"><span>1. leden</span><span>31. prosinec</span></div></section>
                <section id="seasonality-reliability" class="seasonality-reliability" aria-label="Stabilita sezonálního intervalu"><strong>Jak stabilní je vybrané období?</strong><p>Vyber interval v grafu nebo otevři instrument ze Screeneru.</p></section>
            </div>
            <aside class="seasonality-interval-card">
                <div class="seasonality-detail-title">Analýza intervalu</div>
                <div class="seasonality-date-grid"><label>Od<input id="seasonality-start-date" type="date"></label><label>Do<input id="seasonality-end-date" type="date"></label></div>
                <button type="button" id="seasonality-apply-interval">Použít interval</button>
                <button type="button" id="seasonality-clear-interval" class="seasonality-secondary-action">Celý rok</button>
                <div id="seasonality-interval-label" class="seasonality-interval-label">Interval není vybraný</div>
                <div id="seasonality-interval-metrics" class="seasonality-interval-metrics"></div>
                <section class="seasonality-stats" id="seasonality-stats" aria-label="Statistiky seasonality"></section>
            </aside>
        </section>
        <section id="seasonality-confluence" class="confluence-card" aria-label="Souběh sezonality a COT">
            <div class="confluence-heading"><h2>Pomáhá COT v tomto období?</h2><span class="confluence-badge">Historické srovnání</span></div>
            <p id="confluence-placeholder">Vyber období v grafu. Porovnáme, jak často cena rostla nebo klesala ve stejných kalendářních dnech, s podobným COT i bez této podmínky.</p>
            <div id="confluence-body" hidden>
                <div class="confluence-controls">
                    <label>Co sledujeme?<select id="confluence-direction"><option value="up">Cena na konci výše · růst</option><option value="down">Cena na konci níže · pokles</option></select></label>
                    <label>Skupina COT<select id="confluence-group"><option value="commercial">Komerční obchodníci</option><option value="nonCommercial">Velcí spekulanti</option><option value="nonReportable">Malí obchodníci</option></select></label>
                    <label>Podobnost poslednímu indexu<select id="confluence-tolerance"><option value="5">± 5 bodů</option><option value="10" selected>± 10 bodů</option><option value="15">± 15 bodů</option></select></label>
                </div>
                <details class="confluence-settings"><summary>Trh COT, lookback a délka historie</summary><div class="confluence-controls">
                    <label>Report / futures proxy<select id="confluence-market"></select></label>
                    <label>COT index lookback<select id="confluence-lookback"><option value="26">26 reportů</option><option value="52" selected>52 reportů</option><option value="156">156 reportů</option></select></label>
                    <label>Společná historie grafu a COT<select id="confluence-history"><option value="5">Posledních 5 dokončených let</option><option value="10">Posledních 10 dokončených let</option><option value="20" selected>Posledních 20 dokončených let</option><option value="all">Všechna dostupná data</option></select></label>
                </div></details>
                <p id="confluence-status" role="status" aria-live="polite"></p>
                <div id="confluence-results"></div>
                <details class="confluence-method"><summary>Jak procento číst a co nezaručuje?</summary>
                    <p>Procento je historická četnost: počet období se závěrečnou cenou v požadovaném směru dělený počtem všech zahrnutých období. Nulový výnos není úspěchem ani pro růst, ani pro pokles. Nejde o pravděpodobnost zisku obchodu se stop-lossem, náklady nebo pákou. Při méně než 8 soubězích nezobrazujeme velký procentuální odhad; přesný počet a popisná četnost zůstávají v tabulce.</p>
                    <p>Pro férovější porovnání hlavní sezonalita i souběh používají stejnou historii s dostupným COT indexem. Souběh je její podmnožina; rozdíl četností není test statistické významnosti ani důkaz přínosu COT. Sezonalitu za celou cenovou historii ukazujeme zvlášť. Každý rok přispívá nejvýše jedním dokončeným obdobím; aktuální rok je vynechaný. Ručně vybrané roky, Bullish/Bearish i další filtry grafu se do tohoto srovnání nepřenášejí.</p>
                    <p>Vstup je první denní close uvnitř vybraného období, výstup poslední close nejpozději v jeho konci. Okraje a mezery přes 7 dní období vyřadí. Historický COT posuzujeme k výročí dne snapshotu ve stejném předstihu jako Screener. Pokud zvolíš již minulé období, nejpozději při vstupu — nikdy po vstupu. Dostupnost odhadujeme jako datum pozic + 7 kalendářních dní, stáří pozic v okamžiku posouzení může být nejvýše 21 dní. Chybějící index nenahrazujeme starším. Stejná pravidla platí pro dnešní referenci. Skutečná historická data zveřejnění nemáme; mimořádná zpoždění proto mohou výsledek zkreslit. Nejde o přesný point-in-time backtest.</p>
                    <p>95% Wilsonovo pásmo vyjadřuje orientační výběrovou nejistotu četnosti za předpokladu nezávislých případů se stejnou pravděpodobností. Tržní roky tyto předpoklady nemusí splňovat; pásmo nezahrnuje změny režimu, hledání mnoha nastavení ani chybné odhady dostupnosti. Není to pásmo budoucích výnosů ani záruka budoucí pravděpodobnosti.</p>
                    <p>Pohyb proti směru měří největší nepříznivou změnu denního close vůči vstupu v každém období; nejde o intradenní maximum ani návrh stop-lossu. Výnosy jsou změny ceny instrumentu, ne P&amp;L shortu nebo futures proxy. Náklady, skluz a dividendy podle zdroje nejsou samostatně modelované. U FX se posuzuje právě jeden měnový futures report, ne současný stav obou měn.</p>
                    <p>Porovnání starších roků s posledními 5 dokončenými kalendářními roky je jen kontrola změny v čase. Obě části používají stejné dnešní nastavení a byly prohlédnuté; nejde o nezávislý holdout test. Výsledek zatím nemá ověření na nedotčených datech.</p>
                    <p><a href="https://www.itl.nist.gov/div898/handbook/prc/section2/prc241.htm" target="_blank" rel="noopener noreferrer">Metoda Wilsonova intervalu · NIST ↗</a> · <a href="https://www.cftc.gov/MarketReports/CommitmentsofTraders/ReleaseSchedule/index.htm" target="_blank" rel="noopener noreferrer">Kalendář zveřejnění CFTC ↗</a></p>
                </details>
            </div>
        </section>
        <section class="seasonality-detail-grid">
            <div class="seasonality-detail-panel"><div class="seasonality-detail-title">Výnos podle roku</div><canvas id="seasonality-returns-canvas"></canvas></div>
            <div class="seasonality-detail-panel"><div class="seasonality-detail-title">Kumulativní průběh průměrné křivky</div><canvas id="seasonality-cumulative-canvas"></canvas></div>
        </section>
        <section class="seasonality-table-panel" data-export-omit><div class="seasonality-detail-title">Výsledky vybraných let</div><div class="seasonality-table-wrap"><table><thead><tr><th>Rok</th><th>Začátek</th><th>Konec</th><th>Výnos</th><th>Max růst</th><th>Max pokles</th></tr></thead><tbody id="seasonality-year-table"></tbody></table></div></section>
        </div>
        </section>
        <section id="market-cot-view" class="cot-analysis" role="tabpanel" aria-labelledby="market-tab-cot" hidden>
            <div class="cot-toolbar">
                <div><h2 id="cot-asset-title" class="visually-hidden">COT</h2><div id="cot-market-switch" class="cot-market-switch" aria-label="Trh COT reportu"></div><p id="cot-report-meta">CFTC Legacy · Futures Only</p></div>
                <div class="cot-controls">
                    <label>Historie grafů<select id="cot-history" aria-label="Historie grafů"><option value="1">1 rok</option><option value="3" selected>3 roky</option><option value="5">5 let</option><option value="10">10 let</option><option value="all">Vše</option></select></label>
                    <label>COT index lookback<select id="cot-lookback" aria-label="COT index lookback"><option value="26">26 reportů</option><option value="52" selected>52 reportů</option><option value="156">156 reportů</option></select></label>
                    <button type="button" id="cot-export" class="market-export-button" data-export-view="cot" title="Stáhnout COT jako PNG" aria-label="Stáhnout COT jako PNG" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg></button>
                </div>
            </div>
            <p id="cot-market-note" class="cot-market-note" hidden></p>
            <div id="cot-status" class="cot-status" role="status" aria-live="polite"></div>
            <button id="cot-retry" type="button" class="cot-retry" hidden>Zkusit znovu</button>
            <div id="cot-content" hidden>
                <section class="cot-analogs" aria-label="Historické situace podle COT">
                    <h3>Co následovalo při podobném COT?</h3>
                    <p>Vyber skupinu a podobnost. Porovnáme následné výnosy právě vybraného instrumentu, nikoli předpověď jeho ceny. Vstup je odhadovaný: nejdříve 7 dní po datu pozic. Přesná historická data zveřejnění nemáme; nejde o přesný obchodní backtest.</p>
                    <div class="cot-controls">
                        <label>Skupina<select id="cot-analog-group"><option value="commercial">Komerční obchodníci</option><option value="nonCommercial">Velcí spekulanti</option><option value="nonReportable">Malí obchodníci</option></select></label>
                        <label>Situace<select id="cot-analog-mode"><option value="latest">Podobná poslednímu reportu</option><option value="low">Nízký index: 0–20</option><option value="high">Vysoký index: 80–100</option></select></label>
                        <label>Tolerance indexu<select id="cot-analog-tolerance"><option value="5">± 5 bodů</option><option value="10" selected>± 10 bodů</option><option value="15">± 15 bodů</option></select></label>
                    </div>
                    <p id="cot-analog-status" role="status" aria-live="polite"></p>
                    <div id="cot-analog-results"></div>
                    <details class="cot-analog-method"><summary>Jak výsledky číst a jaká mají omezení?</summary><p>Medián je prostřední výnos. Pásmo 25–75 % obsahuje prostředních 50 % případů; není to pravděpodobnost budoucího výnosu. Minimum a maximum ukazují historické extrémy. Kladné případy jsou podíl výnosů nad nulou, ne úspěšnost obchodní strategie.</p><p>Používáme celou dostupnou historii cen a COT, ne pouze období grafů. Index každého reportu pochází jen z tehdejšího lookbacku vybraného nahoře. Bereme chronologicky první podobný report a další případ až po dokončení jeho 8týdenního okna. Všechny horizonty používají stejné dokončené případy.</p><p>Nemáme skutečná historická data zveřejnění. Vstupní cenu bereme nejdříve 7 kalendářních dní po datu pozic, z prvního dostupného denního close. Tento odhad běžnou publikační prodlevu zohledňuje, ale nezaručuje dostupnost při mimořádných zpožděních. Nejde o ověřený point-in-time backtest. Cílová cena je první close od 14 / 28 / 56 dní po vstupu, nejvýše o 4 dny později. Mezery delší než 7 dní a neúplná období vynecháváme.</p><p>Výnos je vždy změna ceny zvoleného instrumentu, ne zisk futures kontraktu nebo short obchodu. U měnových párů a proxy reportů nelze jednotlivý COT zaměnit za celý instrument. Náklady, skluz a dividendy podle cenového zdroje nejsou samostatně modelované. Výběr tolerance a extrémů může zvýhodnit náhodný výsledek. Malý počet případů není důkaz spolehlivosti.</p><a href="https://www.cftc.gov/MarketReports/CommitmentsofTraders/ReleaseSchedule/index.htm" target="_blank" rel="noopener noreferrer">Kalendář zveřejnění CFTC ↗</a></details>
                </section>
                <details class="cot-position-overview"><summary>Přehled aktuálních pozic · long / short</summary><div id="cot-summary" class="cot-summary"></div></details>
                <div class="cot-chart-stack">
                    <article class="cot-chart-card">
                        <div class="cot-chart-heading"><h3>Malí obchodníci <span>Non-reportable</span></h3><div class="cot-legend"><span class="cot-color-small">Čisté pozice</span><span>Sloupce: týdenní změna</span></div></div>
                        <canvas id="cot-small-chart" aria-label="Čisté pozice a týdenní změna malých obchodníků"></canvas>
                    </article>
                    <article class="cot-chart-card">
                        <div class="cot-chart-heading"><h3>Komerční obchodníci <span>Commercials</span></h3><div class="cot-legend"><span class="cot-color-commercial">Čisté pozice</span><span>Sloupce: týdenní změna</span></div></div>
                        <canvas id="cot-commercial-chart" aria-label="Čisté pozice a týdenní změna komerčních obchodníků"></canvas>
                    </article>
                    <article class="cot-chart-card">
                        <div class="cot-chart-heading"><h3>Velcí spekulanti <span>Non-commercials</span></h3><div class="cot-legend"><span class="cot-color-large">Čisté pozice</span><span>Sloupce: týdenní změna</span></div></div>
                        <canvas id="cot-large-chart" aria-label="Čisté pozice a týdenní změna velkých spekulantů"></canvas>
                    </article>
                    <article class="cot-chart-card">
                        <div class="cot-chart-heading"><h3>COT index <span>0–100</span></h3><div class="cot-legend cot-index-controls" aria-label="Viditelné skupiny COT indexu"><button type="button" class="cot-color-small" data-cot-index-group="nonReportable" aria-pressed="true">Malí</button><button type="button" class="cot-color-commercial" data-cot-index-group="commercial" aria-pressed="true">Komerční</button><button type="button" class="cot-color-large" data-cot-index-group="nonCommercial" aria-pressed="true">Velcí</button><span>Extrémy: 20 / 80</span></div></div>
                        <p class="cot-index-hint">Všechny skupiny jsou zapnuté. Kliknutím na legendu je můžeš skrýt; data nejsou vyhlazená.</p>
                        <canvas id="cot-index-chart" aria-label="COT index malých, komerčních a velkých obchodníků"></canvas>
                    </article>
                </div>
                <details class="cot-methodology" data-export-omit><summary>Jak číst COT a co znamenají jednotlivé grafy?</summary>
                    <p>Čisté pozice = long − short (počet futures kontraktů). Sloupce ukazují změnu proti minulému týdnu. Při chybějícím týdenním reportu změnu nezobrazujeme.</p>
                    <p>COT index = 100 × (aktuální čistá pozice − minimum) / (maximum − minimum) v nastaveném počtu reportů včetně aktuálního. Bez dostatečné historie nebo při stejném minimu a maximu index není definovaný. Hranice 20 a 80 zvýrazňují relativní extrémy; nejsou samy o sobě obchodním signálem.</p>
                    <p>Non-reportable jsou pozice pod ohlašovacími limity, nikoli přesný ukazatel retailu. Commercials a non-commercials jsou kategorie Legacy reportu; nelze je zaměňovat s kategoriemi jiných CFTC reportů. Spread vykazujeme samostatně u non-commercials.</p>
                    <p>Neplatné historické řádky zdroje (záporné počty kontraktů nebo nesouhlasící součty) se vynechávají a zaznamenávají do logu aktualizace. Historie může obsahovat mezery. Tabulka zobrazuje nejvýše posledních 260 reportů ve vybraném období.</p>
                    <p>Report obvykle zachycuje úterní pozice a vychází v pátek. Datum v grafu je datum pozic, nikoli okamžik, kdy byla data veřejně dostupná. Historie není určena k simulaci bez této publikační prodlevy.</p>
                    <a href="https://www.cftc.gov/MarketReports/CommitmentsofTraders/index.htm" target="_blank" rel="noopener noreferrer">Zdroj a metodika CFTC ↗</a>
                </details>
                <details class="cot-history-table" data-export-omit><summary>Historické reporty</summary><div class="seasonality-table-wrap"><table><thead><tr><th>Datum pozic</th><th>Malí net</th><th>Δ týdně</th><th>Komerční net</th><th>Δ týdně</th><th>Velcí net</th><th>Δ týdně</th><th>Open interest</th></tr></thead><tbody id="cot-report-table"></tbody></table></div></details>
